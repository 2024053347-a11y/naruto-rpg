PORT=3000
NODE_ENV=development
# GitHub 本地运行版本：开启旁路模式，无需 Discord 登录
AUTH_BYPASS=true
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# DISCORD_REQUIRED_GUILD_ID=your-discord-server-id
JWT_SECRET=change-this-to-a-random-secret-for-jwt-signing
JWT_EXPIRES_IN=7d
MAX_SAVE_SLOTS=5
MAX_SAVE_SIZE_MB=10
# PROXY_ENABLED=true
# PROXY_URL=http://127.0.0.1:7890

# ── 构建/同步工具链（scripts/）────────────────────────────
# SillyTavern 安装目录（含 data/ 子目录）；watch/sync-card 脚本用它定位角色卡
# TAVERN_DIR=D:/SillyTavern/SillyTavern
# 要同步的角色卡 PNG 文件名（默认 忍者手记.png）
# TAVERN_CARD_NAME=忍者手记.png
# 手动导入用 regex JSON 的额外落盘目录（未配置则跳过该步骤）
# MANUAL_EXPORT_DIR=D:/Downloads/忍者手记
# 设为 false 可让 watch 模式跳过角色卡 PNG 同步（默认 true）
# SYNC_TO_PNG=true
