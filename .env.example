PORT=3000
NODE_ENV=development
# GitHub 本地运行版本：开启旁路模式，无需 Discord 登录
AUTH_BYPASS=true
# 直连部署保持未设置/false；仅在可信反向代理后方配置地址、命名网段或代理跳数
# TRUST_PROXY=loopback
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# DISCORD_REQUIRED_GUILD_ID=your-discord-server-id
JWT_SECRET=change-this-to-a-random-secret-for-jwt-signing
JWT_EXPIRES_IN=7d
MAX_SAVE_SLOTS=5
# gzip 解压后的云存档正文上限；新上传必须同时满足压缩体上限
MAX_SAVE_SIZE_MB=200
MAX_SAVE_COMPRESSED_SIZE_MB=64
# 旧客户端 application/json 兼容上限，超过后返回 GZIP_UPLOAD_REQUIRED
MAX_LEGACY_SAVE_SIZE_MB=16
# 流式 JSON 校验与上传并发边界
MAX_SAVE_JSON_DEPTH=256
SAVE_UPLOAD_GLOBAL_CONCURRENCY=2
# 云存档列表预览元数据上限
MAX_SAVE_PREVIEW_SIZE_KB=64
# 私有文生图图库（正文与缩略图均计入用户总配额）
IMAGE_ASSET_QUOTA_MB=1024
IMAGE_ASSET_MAX_COUNT=500
IMAGE_ASSET_MAX_ORIGINAL_MB=20
IMAGE_ASSET_MAX_THUMBNAIL_KB=512
IMAGE_ASSET_MAX_METADATA_KB=32
IMAGE_ASSET_MAX_PIXELS=16000000
IMAGE_ASSET_MAX_SIDE=8192
IMAGE_ASSET_MAX_SELECTIONS=5000
# 图片正文写入 staging 前的全局并发上限；同一用户始终只允许 1 个
IMAGE_ASSET_UPLOAD_GLOBAL_CONCURRENCY=4
# 活动任务引用是可续租的临时保护，避免浏览器硬崩后图片永久无法删除或驱逐
IMAGE_ASSET_ACTIVE_REFERENCE_TTL_MINUTES=60
# 可选：允许网页直连的局域网推理服务来源，与画面设置白名单保持一致（逗号分隔）
# IMAGE_LOCAL_CONNECT_SOURCES=http://192.168.1.20:8188,http://192.168.1.20:7860
# 运行数据目录；生产环境建议使用仓库外的持久化路径
# DATA_DIR=D:/naruto-rpg-data
# PROXY_ENABLED=true
# PROXY_URL=http://127.0.0.1:7890
# Clash/Mihomo fake-IP DNS 兼容：开发环境默认 true，生产环境默认 false
# AI_PROXY_ALLOW_FAKE_IP_DNS=true
# AI_PROXY_TIMEOUT_MS=120000
# AI_PROXY_MAX_RESPONSE_MB=20
# 公网生图允许更长生成时间与 Base64 JSON 膨胀后的响应体
# IMAGE_PROXY_TIMEOUT_MS=300000
# IMAGE_PROXY_MAX_RESPONSE_MB=32

# ── 打包/同步工作流（scripts/sync-to-card.mjs、scripts/watch-and-sync.mjs）──
# SillyTavern 安装目录（不配置时按历史默认路径探测）
# TAVERN_DIR=D:/SillyTavern/SillyTavern
# 酒馆用户目录名
# TAVERN_USER=default-user
# 角色卡 PNG 文件名
# TAVERN_CARD_NAME=忍者手记.png
# regex JSON 副本导出目录（供手动导入酒馆；不配置且默认目录不存在时跳过）
# MANUAL_EXPORT_DIR=D:/Downloads/忍者手记
